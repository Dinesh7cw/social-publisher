# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_ORIGIN=http://localhost:3010
APP_URL=http://localhost:3010
PORT=3010

# --- Database --------------------------------------------------------------
# Port 55440 is used because 5432/55432 are taken by other local projects.
DATABASE_URL=postgresql://cw:cw_dev_password@localhost:55440/cw_social?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:56390

# --- Sessions and crypto ---------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-bytes-base64
# AES-256-GCM key for OAuth tokens. 32 bytes, base64. Rotate via keyId.
TOKEN_ENCRYPTION_KEY=replace-me-with-32-bytes-base64

# --- Object storage (S3 / MinIO) -------------------------------------------
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=cw-social
S3_ACCESS_KEY_ID=cw_minio
S3_SECRET_ACCESS_KEY=cw_minio_password
S3_FORCE_PATH_STYLE=true

# Public base URL for the media projection Meta/Instagram must fetch.
# In dev this is the MinIO public bucket through its own port.
MEDIA_PUBLIC_BASE_URL=http://localhost:9010/cw-social-public

# --- Platform feature flags ------------------------------------------------
# Turn a platform on only after docs/PLATFORM-ACCESS.md is complete for it.
FACEBOOK_ENABLED=false
INSTAGRAM_ENABLED=false
LINKEDIN_ENABLED=false
X_ENABLED=false

# --- Meta / Facebook / Instagram -------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202601

# --- X ---------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Queue -----------------------------------------------------------------
PUBLISH_QUEUE_NAME=cw-publish
PUBLISH_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4

# --- Seed admin (dev only; change before deploying) ------------------------
SEED_ADMIN_EMAIL=admin@colorwhistle.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=CW Admin
