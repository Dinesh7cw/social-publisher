# Production environment template.
#
# Copy to .env.production and fill every value. NEVER commit .env.production.
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Generate the two secrets with:
#   openssl rand -base64 32
#
# This file intentionally contains no real credentials.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Must match the public origin exactly: the API rejects mutations whose Origin
# header differs, which is the CSRF defence.
APP_ORIGIN=https://publisher.colorwhistle.com
APP_URL=https://publisher.colorwhistle.com
PORT=3010

# --- Postgres (internal to the compose network) ----------------------------
POSTGRES_USER=cw
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cw_social
DATABASE_URL=postgresql://cw:CHANGE_ME_STRONG_PASSWORD@postgres:5432/cw_social?schema=public

# --- Redis (internal) ------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Secrets ---------------------------------------------------------------
# 32 bytes, base64. Rotating SESSION_SECRET signs everyone out; rotating
# TOKEN_ENCRYPTION_KEY requires re-encrypting stored tokens (see OPERATIONS.md).
SESSION_SECRET=CHANGE_ME_32_BYTES_BASE64
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# --- Object storage --------------------------------------------------------
# Any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# The public bucket must allow anonymous GET: Meta and Instagram fetch media from
# it themselves, so a private-only bucket makes those platforms impossible.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=cw-social
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://media.colorwhistle.com

# --- Platform flags --------------------------------------------------------
# Leave a platform false until docs/PLATFORM-ACCESS.md is complete for it.
# A platform cannot publish with its flag off, and the UI says so honestly.
FACEBOOK_ENABLED=false
INSTAGRAM_ENABLED=false
LINKEDIN_ENABLED=false
X_ENABLED=false

# --- Meta ------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# --- LinkedIn --------------------------------------------------------------
# Organization posting needs the Community Management API, which LinkedIn
# approves manually. Until it is approved, leave LINKEDIN_ENABLED=false.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202601

# --- X ---------------------------------------------------------------------
# offline.access is required; without it access tokens die after ~2 hours and
# scheduled posts fail.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Queue -----------------------------------------------------------------
PUBLISH_QUEUE_NAME=cw-publish
PUBLISH_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4
